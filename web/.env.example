# Copy to web/.env.local (never commit). Same keys go in Railway service variables.
# Gateway the browser proxies through (server-side rewrite, no CORS needed).
WAYFINDER_API_URL=http://127.0.0.1:8000

# Public origin of THIS web app (used for session endpoints + metadata).
NEXT_PUBLIC_WEBSITE_DOMAIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keyless local dev (gateway dev-admin serves platform APIs directly).
# Unset/empty on Railway so managed SuperTokens sign-in is enforced.
NEXT_PUBLIC_AUTH_DISABLED=1

# Social login buttons (csv subset of: google,github). Shown only when the
# gateway also has the matching THIRD_PARTY_* OAuth credentials.
NEXT_PUBLIC_OAUTH_PROVIDERS=
