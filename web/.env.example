# Copy to web/.env.local (never commit). Same keys go in Railway service variables.
# Gateway the browser proxies through (server-side rewrite, no CORS needed).
WAYFINDER_API_URL=http://127.0.0.1:8000

# Managed auth (Clerk). Unset both for keyless local dev (dev-admin mode).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Canonical site URL for metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
