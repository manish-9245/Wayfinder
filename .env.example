# Local overrides. Copy to .env (never commit .env).
# NOTE: canonical prefix is WAYFINDER_* (DATABASE_URL is also honored).

# Hugging Face token: raises rate limits for first checkpoint download.
HF_TOKEN=

# --- gateway ---
# Bearer auth for the gateway. Empty means open (dev only).
WAYFINDER_API_KEY=
# Torch device: cpu, cuda, mps. Empty means auto.
LAYA_DEVICE=
# Preload checkpoints at boot (1) or lazily (0).
WAYFINDER_PRELOAD=0
# Comma list of checkpoints to keep resident.
LAYA_MODELS=english,multilingual
# Shared cache across replicas. Empty means local LRU only.
WAYFINDER_REDIS_URL=
# Web console origin of the gateway for local dev.
WAYFINDER_API_URL=http://127.0.0.1:8000

# --- platform database (SQLite file by default, Postgres in production) ---
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/wayfinder

# --- managed auth (Clerk). Leave unset for keyless local dev (dev-admin). ---
# CLERK_ENABLED=1
# CLERK_JWKS_URL=https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER=https://<your-instance>.clerk.accounts.dev
# CLERK_SECRET_KEY=sk_test_...
# Comma list of emails that are always super-admin.
# WAYFINDER_SUPERADMINS=you@company.com

# --- rate limits (per minute) / quotas (per month, 0 = unlimited) ---
# WAYFINDER_RATE_FREE_PER_MIN=60
# WAYFINDER_RATE_PRO_PER_MIN=600
# WAYFINDER_RATE_IP_PER_MIN=120
# WAYFINDER_QUOTA_FREE=10000
# WAYFINDER_QUOTA_PRO=500000

# --- tests only (never in prod) ---
# WAYFINDER_TEST_AUTH=1
